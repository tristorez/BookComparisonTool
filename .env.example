# Local development: copy to .env (gitignored). The board (`npm run dev`, `npm start`) reads it; variables
# already in the environment win; the feed entry (Box B) reads only its environment. Defaults shown.
# Per-book variables start with the book's short code from src/server/registry.ts (DK_, FD_, FAKE_MODE_DK).
ROLE=board                 # board (Box A) | feed (Box B: dist/feed/index.js)
FEED_ID=A                  # this box's feed id (A on the board box, B on the feed box)
PORT=8080
BOOKS=draftkings,fanduel   # or "fake" for synthetic books (no network; works outside the US)
FAKE_RATE=4                # fake price changes per second per book
FAKE_MODE_DK=normal        # normal | fail | freeze | garbage | massRemove (resilience drills)
FAKE_MODE_FD=normal
DK_STATE=nj                # DraftKings jurisdiction (dkusnj / sportsbook-ws-us-nj)
DK_PROXY_URL=              # optional HTTP(S) proxy for both DK channels
DK_REST_PROXY_URL=         # ...or only the REST snapshot
DK_WS_PROXY_URL=           # ...or only the socket
DK_TOKEN_MODE=default      # or anonymous-jwt: start on DK's anonymous JWT instead of "default-token"
FD_REGION=nj               # FanDuel state subdomain
FD_PUSH=1                  # 0 disables the PIR push subscription
FD_POLL_MS=1000            # SMP poll cadence; 0 disables polling
FD_POLL_PHASE_MS=0         # wall-clock poll phase (Box A 0, Box B 500)
FD_PROXY_URL=
FD_APP_KEY=                # starting keys (default: the ones in FD's bundle); a wrong one exercises the re-read
FD_PIR_KEY=
FEED_LISTEN=               # board: host:port Box B connects to (private address)
FEED_UPSTREAM=             # feed: Box A's private host:port
FEED_TOKEN=                # shared secret for the feed link (16+ chars)
STALE_GRACE_MS=5000        # a feed must be unhealthy this long before its book shows stale
STALE_AFTER_DK_MS=15000    # no proof of life for this long → unhealthy
STALE_AFTER_FD_MS=5000
CHAOS=0                    # 1 enables POST /api/dev/feeds/:feed/:book/stop|start (refused in production)
LOG_LEVEL=info
