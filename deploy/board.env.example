# /etc/odds/board.env on Box A (root:root 0600). See .env.example for every variable.
NODE_ENV=production
ROLE=board
FEED_ID=A
HOST=127.0.0.1
PORT=8080
BOOKS=draftkings,fanduel
DK_STATE=nj
FD_REGION=nj
FD_POLL_MS=1000
FD_POLL_PHASE_MS=0
# Box B connects here over the VPC (security group: 7070 from Box B only).
FEED_LISTEN=<box-a-private-ip>:7070
FEED_TOKEN=<openssl rand -hex 32>
LOG_LEVEL=warn
